# Auto detect text files and perform LF normalization
* text=auto eol=lf

# Explicit text file types
*.ts text eol=lf
*.tsx text eol=lf
*.js text eol=lf
*.jsx text eol=lf
*.json text eol=lf
*.css text eol=lf
*.html text eol=lf
*.md text eol=lf
*.sql text eol=lf
*.toml text eol=lf
*.yaml text eol=lf
*.yml text eol=lf

# Binary file types
*.png binary
*.jpg binary
*.jpeg binary
*.jfif binary
*.gif binary
*.ico binary
*.woff binary
*.woff2 binary
*.ttf binary
